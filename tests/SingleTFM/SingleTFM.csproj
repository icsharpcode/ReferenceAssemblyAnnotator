<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TestFramework)</TargetFramework>
    <LangVersion>8</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>RA1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netcoreapp1.0' OR '$(TargetFramework)' == 'netcoreapp1.1'">
    <!-- CS1701: Assuming assembly reference "Assembly Name #1" matches "Assembly Name #2", you may need to supply runtime policy -->
    <NoWarn>$(NoWarn),CS1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Condition="'$(TargetFramework)' != 'net35'" Include="System.Data.SqlClient" Version="4.8.0" />
    <PackageReference Include="ICSharpCode.ReferenceAssemblyAnnotator" Version="2.0.0-*" PrivateAssets="all" />
    <!-- .NET Core 3.0+ isn't annotated (its reference assemblies already are), and the SDK may add its own download of
         Microsoft.NETCore.App.Ref for it (when the targeting pack isn't installed); a second one fails with NU1505. -->
    <PackageDownload Condition="!$(TargetFramework.StartsWith('netcoreapp3.')) AND !$(TargetFramework.StartsWith('net10.'))" Include="Microsoft.NETCore.App.Ref" Version="[10.0.0]" />
  </ItemGroup>

</Project>
