<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".isolatednugetcache" />
  </config>
  <packageSources>
    <clear />
    <!-- Forward slashes: with backslashes, source mapping does not match this source on Linux/macOS (NU1100). -->
    <add key="Local build" value="../ICSharpCode.ReferenceAssemblyAnnotator/bin/%CONFIGURATION%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- The annotator under test always comes from the local build, never from nuget.org. -->
    <packageSource key="Local build">
      <package pattern="ICSharpCode.ReferenceAssemblyAnnotator" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
